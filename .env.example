# Copy to .env and fill in. Never commit .env.

# --- Fluxer ------------------------------------------------------------------
# Bot token from your application's Bot page on YOUR instance
# (format: <application_id>.<secret>). Paste it raw, without "Bot ".
FLUXER_BOT_TOKEN=

# Your self-hosted instance. Endpoints are discovered from
# <instance>/.well-known/fluxer unless overridden below.
FLUXER_INSTANCE_URL=https://fluxer.squeekienuts.net

# Optional overrides. Leave blank to use discovery (recommended first).
# To stay entirely inside Docker, point these at the Fluxer containers, e.g.
#   FLUXER_API_URL=http://api:8080
#   FLUXER_GATEWAY_URL=ws://gateway:8080/
# (use the service names from `docker network inspect <network>`).
FLUXER_API_URL=
FLUXER_GATEWAY_URL=

# Name of Fluxer's Docker network (see `docker network ls`).
FLUXER_DOCKER_NETWORK=fluxer_default

# --- Database ----------------------------------------------------------------
# <postgres-host> is the PostgreSQL container/service name on the Fluxer network.
# Special characters in the password must be URL-encoded (@ -> %40, : -> %3A, / -> %2F).
DATABASE_URL=postgres://wordle_bot:CHANGE_ME@<postgres-host>:5432/wordle_bot

# Only used by the optional standalone database (profile "standalone-db").
# If you use it, set DATABASE_URL host to wordle-db.
WORDLE_DB_PASSWORD=

# --- Game --------------------------------------------------------------------
PUZZLE_TIMEZONE=America/New_York
COMMAND_PREFIX=!wordle
LEADERBOARD_SIZE=15
NYT_WORDLE_URL=https://www.nytimes.com/svc/wordle/v2
# Optional custom dictionary (one five-letter word per line), e.g. /data/words.txt
# placed in /mnt/media/appdata/wordle-bot/data/words.txt on the host.
WORDS_FILE=

# --- Logging -----------------------------------------------------------------
# info is normal; use debug,sqlx=warn to troubleshoot.
RUST_LOG=info,sqlx=warn
TZ=America/New_York
